menu "CW-WW LED Controller Configuration"

    menu "Hardware Pin Configuration"
        config LED_CW_GPIO
            int "Cool White (CW) PWM GPIO Pin"
            default 0
            help
                GPIO pin connected to the Cool White LED MOSFET driver.

        config LED_WW_GPIO
            int "Warm White (WW) PWM GPIO Pin"
            default 1
            help
                GPIO pin connected to the Warm White LED MOSFET driver.

        config STATUS_LED_GPIO
            int "Status Indicator LED GPIO Pin"
            default 8
            help
                GPIO pin connected to the status indicator LED.

        config STATUS_LED_ACTIVE_LEVEL
            int "Status LED Active Level (0 for Active-Low, 1 for Active-High)"
            range 0 1
            default 0
            help
                Logic level that turns the status LED ON. Standard devboards usually have active-low LEDs.

        config BUTTON_GPIO
            int "Push Button GPIO Pin"
            default 9
            help
                GPIO pin connected to the control push button (default BOOT pin on ESP32-C6).

        config FACTORY_RESET_HOLD_TIME_SEC
            int "Factory Reset Button Hold Time (seconds)"
            default 10
            help
                Number of seconds the button must be held down to trigger a factory reset.

        config PWM_FREQUENCY_HZ
            int "PWM Frequency in Hz"
            default 22000
            help
                PWM frequency for LEDC driver (default 22000 Hz, inaudible and flicker-free).
    endmenu

    menu "Custom MAC Address Configuration"
        config CUSTOM_MAC_ENABLE
            bool "Enable Custom Wi-Fi MAC Address"
            default y
            help
                When enabled, the firmware overrides the factory eFuse base MAC address
                using either the static MAC configured below or one stored in NVS under key 'custom_mac'.

        config CUSTOM_MAC_ADDRESS
            string "Default Static MAC Address"
            default "A0:B1:C2:D3:E4:F5"
            depends on CUSTOM_MAC_ENABLE
            help
                Custom Base/Wi-Fi MAC address formatted as XX:XX:XX:XX:XX:XX.
                Must have bit 0 of the first byte set to 0 (unicast) and bit 1 set to 1 (locally administered).
    endmenu

    menu "Color Temperature Limits"
        config MIN_COLOR_TEMP_MIREDS
            int "Minimum Color Temperature in Mireds (Coolest, e.g. 6500K = 153 Mireds)"
            default 153
            help
                Matter specification minimum mireds (1,000,000 / K). 153 corresponds to ~6535K.

        config MAX_COLOR_TEMP_MIREDS
            int "Maximum Color Temperature in Mireds (Warmest, e.g. 2700K = 370 Mireds)"
            default 370
            help
                Matter specification maximum mireds (1,000,000 / K). 370 corresponds to ~2702K.
    endmenu

endmenu
